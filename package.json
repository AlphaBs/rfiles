{
  "name": "rfiles",
  "version": "0.0.0",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start": "pnpm run dev",
    "deploy": "wrangler deploy",
    "build": "pnpm run openapi:generate && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test:coverage && pnpm run build"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@scalar/hono-api-reference": "^0.12.0",
    "@valibot/to-json-schema": "^1.7.1",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.7",
    "hono-openapi": "^1.3.1",
    "valibot": "^1.4.2"
  },
  "type": "module",
  "description": "Hash based file server on Cloudflare Workers and R2",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.0"
}
